NODE_ENV=development
PORT=5001

# Any string works for local dev - use long random values for anything real
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme-too
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# From your Stripe dashboard (dashboard.stripe.com) in test mode:
# Developers -> API keys for the first one, and the `stripe listen` command
# prints the webhook secret once it's running - see the README for the
# full sequence.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

FRONTEND_URL=http://localhost:3000
